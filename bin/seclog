#!/usr/bin/env bash
# seclog — show the current SSH security status. Read-only, sends no push.

set -uo pipefail

SECLOG_LIB="$(dirname "$(readlink -f "$0")")/seclog-lib.sh"
[[ -f $SECLOG_LIB ]] || SECLOG_LIB="$HOME/.local/bin/seclog-lib.sh"
# shellcheck source=seclog-lib.sh
. "$SECLOG_LIB"

usage() {
    cat <<'HELP'
Usage: seclog [lookback]

Shows active TCP connections, recent successful SSH logins and failed login
attempts. Nothing is pushed to ntfy — use this to inspect the machine you are
already on.

Arguments:
  lookback      How far back to scan for failed attempts, in any format
                journalctl --since accepts. Default: the FAIL_LOOKBACK value
                from the config, or "24 hours ago".

Options:
  -h, --help    Show this help.
  -V, --version Show the version.

Examples:
  seclog
  seclog "1 hour ago"
  seclog "2024-01-01"
HELP
}

seclog_load_config
seclog_init_colors

# FAIL_LOOKBACK and JOURNAL_TIMEOUT are read back by the library functions.
# shellcheck disable=SC2034
case "${1:-}" in
    -h|--help)    usage; exit 0 ;;
    -V|--version) printf 'seclog %s\n' "$SECLOG_VERSION"; exit 0 ;;
    -*)           printf 'seclog: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    ?*)           FAIL_LOOKBACK="$1" ;;
esac

# Interactive use can afford to wait longer for journald than a login banner.
JOURNAL_TIMEOUT="${SECLOG_CLI_JOURNAL_TIMEOUT:-10}"

seclog_print_report
