#!/usr/bin/env bash
# seclog-update — fast-forward the installed checkout to the newest signed
# commit on its current branch, re-run the installer and restart the monitor.
#
# Safety rails, all of which must pass before anything is pulled:
#   1. the checkout lives at the expected path (override needs an explicit opt-in)
#   2. `origin` points at the expected repository
#   3. the target commit carries a good GPG signature
#   4. the user confirms the change interactively (skip with --yes)

set -euo pipefail

SECLOG_LIB="$(dirname "$(readlink -f "$0")")/seclog-lib.sh"
[[ -f $SECLOG_LIB ]] || SECLOG_LIB="$HOME/.local/bin/seclog-lib.sh"
# shellcheck source=seclog-lib.sh
. "$SECLOG_LIB"

seclog_load_config

DEFAULT_REPO_DIR="$HOME/Projects/seclog-linux"
REPO_DIR="${SECLOG_REPO_DIR:-$DEFAULT_REPO_DIR}"
SERVICE="seclog-monitor.service"
ALLOW_CUSTOM_REPO_DIR="${ALLOW_CUSTOM_REPO_DIR:-0}"
EXPECTED_ORIGINS=(
    "${EXPECTED_UPDATE_ORIGIN:-https://github.com/arn-c0de/seclog-linux.git}"
    "${EXPECTED_UPDATE_ORIGIN_ALT:-git@github.com:arn-c0de/seclog-linux.git}"
)

ASSUME_YES=0
[[ ${1:-} == --yes || ${1:-} == -y ]] && ASSUME_YES=1

die() { printf 'seclog-update: %s\n' "$*" >&2; exit 1; }

# ── 1. Locate and validate the checkout ──────────────────────────────────
[[ -d $REPO_DIR/.git ]] || die "no git checkout at $REPO_DIR — set SECLOG_REPO_DIR and retry"

repo="$(cd -- "$REPO_DIR" && pwd -P)"
expected_repo="$DEFAULT_REPO_DIR"
[[ -d $DEFAULT_REPO_DIR ]] && expected_repo="$(cd -- "$DEFAULT_REPO_DIR" && pwd -P)"

if [[ -n ${SECLOG_REPO_DIR:-} && $repo != "$expected_repo" && $ALLOW_CUSTOM_REPO_DIR != 1 ]]; then
    die "refusing a custom SECLOG_REPO_DIR without ALLOW_CUSTOM_REPO_DIR=1"$'\n'"  expected: $expected_repo"$'\n'"  got:      $repo"
fi

cd -- "$repo"

origin="$(git remote get-url origin)"
matched=0
for candidate in "${EXPECTED_ORIGINS[@]}"; do
    [[ $origin == "$candidate" ]] && matched=1
done
(( matched )) || die "refusing to update from an unexpected origin: $origin"$'\n'"  expected one of: ${EXPECTED_ORIGINS[*]}"

branch="$(git branch --show-current)"
[[ -n $branch ]] || die "no branch checked out in $repo (detached HEAD)"

installer="$repo/install.sh"
[[ -f $installer ]] || die "installer not found at $installer"

# ── 2. Compare local and remote ──────────────────────────────────────────
echo "== seclog-update =="
printf 'Repo:    %s\nBranch:  %s\nRemote:  %s\n' "$repo" "$branch" "$origin"

git fetch origin --prune

local_commit="$(git rev-parse HEAD)"
remote_commit="$(git rev-parse "origin/$branch")"
local_short="$(git rev-parse --short "$local_commit")"
remote_short="$(git rev-parse --short "$remote_commit")"

printf 'Current: %s (%s)\n' "$local_short" "$(git log -1 --pretty=%s "$local_commit")"

if [[ $local_commit == "$remote_commit" ]]; then
    echo "Update:  already up to date"
    exit 0
fi

printf 'Target:  %s (%s)\n' "$remote_short" "$(git log -1 --pretty=%s "$remote_commit")"

# ── 3. Require a good signature on the target commit ─────────────────────
verify_output=""
verify_status=0
verify_output="$(git verify-commit "$remote_commit" 2>&1)" || verify_status=$?
signer="$(awk '/^Good "git" signature for / { sub(/^Good "git" signature for /, ""); print; exit }' \
    <<<"$verify_output")"

if (( verify_status != 0 )) || [[ -z $signer ]]; then
    printf 'VERIFIED: no — aborting\n%s\n' "$verify_output" >&2
    exit 1
fi
printf 'VERIFIED: yes (%s)\n' "$signer"

# ── 4. Confirm, then apply ───────────────────────────────────────────────
if (( ! ASSUME_YES )); then
    read -r -p "Proceed with update? [y/N] " confirm
    [[ $confirm == [yY] ]] || { echo "Aborted."; exit 0; }
fi

printf 'Updating: %s -> %s\n' "$local_short" "$remote_short"
git merge --ff-only "$remote_commit"

bash "$installer"

systemctl --user daemon-reload
systemctl --user restart "$SERVICE"

# ── 5. Announce ──────────────────────────────────────────────────────────
new_short="$(git rev-parse --short HEAD)"
subject="$(git log -1 --pretty=%s HEAD)"
host="$(hostname)"
ip="$(hostname -I 2>/dev/null | awk '{ print $1 }')"
[[ -z $ip ]] && ip="$(ip route get 1 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }')"

body="$(printf 'Host:    %s\nIP:      %s\nBranch:  %s\nFrom:    %s\nTo:      %s\nCommit:  %s\nSigner:  %s\nTime:    %s' \
    "$host" "${ip:-unknown}" "$branch" "$local_short" "$new_short" "$subject" "$signer" \
    "$(date '+%Y-%m-%d %H:%M:%S %Z')")"

seclog_push "seclog updated on $host: $subject" "arrows_counterclockwise,white_check_mark" "default" "$body" || true

printf 'Service: %s\n' "$(systemctl --user is-active "$SERVICE" || true)"
printf 'Commit:  %s (%s)\n' "$new_short" "$subject"
