#!/bin/bash
# Update an installed seclog-linux checkout to the newest commit on its current
# branch, then re-run the installer so deployed scripts stay in sync.

set -euo pipefail

DEFAULT_REPO_DIR="$HOME/Projects/seclog-linux"
REPO_DIR="${SECLOG_REPO_DIR:-$HOME/Projects/seclog-linux}"
SERVICE="seclog-linux-fail-monitor.service"
CONFIG="${SSH_NOTIFY_CONFIG:-$HOME/.config/seclog-linux/config}"
ALLOW_CUSTOM_REPO_DIR="${ALLOW_CUSTOM_REPO_DIR:-0}"
EXPECTED_UPDATE_ORIGIN="${EXPECTED_UPDATE_ORIGIN:-https://github.com/arn-c0de/seclog-linux.git}"
EXPECTED_UPDATE_ORIGIN_ALT="${EXPECTED_UPDATE_ORIGIN_ALT:-git@github.com:arn-c0de/seclog-linux.git}"

if [ -f "$CONFIG" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG"
fi

if [ ! -d "$REPO_DIR/.git" ]; then
    echo "No git checkout found at: $REPO_DIR" >&2
    echo "Set SECLOG_REPO_DIR to your seclog-linux checkout and retry." >&2
    exit 1
fi

REPO_REAL="$(cd -- "$REPO_DIR" && pwd -P)"
DEFAULT_REPO_REAL="$DEFAULT_REPO_DIR"
[ -d "$DEFAULT_REPO_DIR" ] && DEFAULT_REPO_REAL="$(cd -- "$DEFAULT_REPO_DIR" && pwd -P)"

if [ "${SECLOG_REPO_DIR+x}" = "x" ] && [ "$REPO_REAL" != "$DEFAULT_REPO_REAL" ] && [ "$ALLOW_CUSTOM_REPO_DIR" != "1" ]; then
    echo "Refusing custom SECLOG_REPO_DIR without ALLOW_CUSTOM_REPO_DIR=1" >&2
    echo "Expected: $DEFAULT_REPO_REAL" >&2
    echo "Got:      $REPO_REAL" >&2
    exit 1
fi

cd -- "$REPO_REAL"

ORIGIN_URL="$(git remote get-url origin)"
if [ "$ORIGIN_URL" != "$EXPECTED_UPDATE_ORIGIN" ] && [ "$ORIGIN_URL" != "$EXPECTED_UPDATE_ORIGIN_ALT" ]; then
    echo "Refusing update from unexpected origin remote." >&2
    echo "Expected: $EXPECTED_UPDATE_ORIGIN or $EXPECTED_UPDATE_ORIGIN_ALT" >&2
    echo "Got:      $ORIGIN_URL" >&2
    exit 1
fi

BRANCH="$(git branch --show-current)"
if [ -z "$BRANCH" ]; then
    echo "No current branch checked out in $REPO_REAL" >&2
    exit 1
fi

INSTALL_SCRIPT="$REPO_REAL/install.sh"
if [ ! -f "$INSTALL_SCRIPT" ]; then
    echo "Installer not found at: $INSTALL_SCRIPT" >&2
    exit 1
fi

echo "== seclog-update =="
echo "Repo:    $REPO_REAL"
echo "Branch:  $BRANCH"
echo "Remote:  $ORIGIN_URL"

git fetch origin --prune

LOCAL_COMMIT="$(git rev-parse HEAD)"
REMOTE_REF="origin/$BRANCH"
REMOTE_COMMIT="$(git rev-parse "$REMOTE_REF")"
LOCAL_SHORT="$(git rev-parse --short "$LOCAL_COMMIT")"
REMOTE_SHORT="$(git rev-parse --short "$REMOTE_COMMIT")"
LOCAL_SUBJECT="$(git log -1 --pretty=%s "$LOCAL_COMMIT")"
REMOTE_SUBJECT="$(git log -1 --pretty=%s "$REMOTE_COMMIT")"

echo "Current: $LOCAL_SHORT"
echo "Target:  $REMOTE_SHORT"
echo "Message: $REMOTE_SUBJECT"

if [ "$LOCAL_COMMIT" = "$REMOTE_COMMIT" ]; then
    echo "Update:  already up to date"
    echo "Commit:  $LOCAL_SHORT ($LOCAL_SUBJECT)"
    exit 0
fi

echo "Verify:  commit signature required"
VERIFY_OUTPUT="$(git verify-commit "$REMOTE_COMMIT" 2>&1)"
VERIFY_STATUS=$?
VERIFY_SIGNER="$(printf '%s\n' "$VERIFY_OUTPUT" | awk '/^Good "git" signature for / {sub(/^Good "git" signature for /, ""); print; exit}')"
if [ $VERIFY_STATUS -ne 0 ] || [ -z "$VERIFY_SIGNER" ]; then
    echo "VERIFIED: NO — aborting" >&2
    printf '%s\n' "$VERIFY_OUTPUT" >&2
    exit 1
fi
echo "VERIFIED: yes"
echo "Signer:   $VERIFY_SIGNER"

echo "Update:  available"
printf "Proceed with update? [y/N] "
read -r confirm
case "$confirm" in
    y|Y) ;;
    *)
        echo "Aborted."
        exit 0
        ;;
esac
echo "Updating: $LOCAL_SHORT -> $REMOTE_SHORT"
git pull --ff-only origin "$BRANCH"

/bin/bash "$INSTALL_SCRIPT"

systemctl --user daemon-reload
systemctl --user restart "$SERVICE"

UPDATE_HOST="$(hostname)"
UPDATE_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
[ -z "$UPDATE_IP" ] && UPDATE_IP="$(ip route get 1 2>/dev/null | awk '/src/ {for (i=1; i<=NF; i++) if ($i=="src") {print $(i+1); exit}}')"
[ -z "$UPDATE_IP" ] && UPDATE_IP="unknown"
UPDATE_TIME="$(date '+%Y-%m-%d %H:%M:%S %Z')"
UPDATE_COMMIT_TEXT="$(git log -1 --pretty=%s HEAD)"

if [ -n "${NTFY_URL:-}" ]; then
    BODY=$(printf 'Host:    %s\nIP:      %s\nBranch:  %s\nFrom:    %s\nTo:      %s\nCommit:  %s\nTime:    %s' \
        "$UPDATE_HOST" \
        "$UPDATE_IP" \
        "$BRANCH" \
        "$LOCAL_SHORT" \
        "$(git rev-parse --short HEAD)" \
        "$UPDATE_COMMIT_TEXT" \
        "$UPDATE_TIME")

    curl -fsS -m 3 \
        -H "Title: seclog updated on $UPDATE_HOST: $UPDATE_COMMIT_TEXT" \
        -H "Tags: arrows_counterclockwise,white_check_mark" \
        -H "Priority: default" \
        ${NTFY_TOKEN:+-H "Authorization: Bearer $NTFY_TOKEN"} \
        -d "$BODY" \
        "$NTFY_URL" >/dev/null 2>&1 || true
fi

echo "Service: $(systemctl --user is-active "$SERVICE")"
echo "Commit:  $(git rev-parse --short HEAD) ($UPDATE_COMMIT_TEXT)"
