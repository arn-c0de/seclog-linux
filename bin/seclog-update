#!/usr/bin/env bash
# seclog-update — fast-forward the installed checkout to the newest signed
# release, re-run the installer and restart the monitor.
#
# Channels (UPDATE_CHANNEL in the config, or --channel):
#   release  the newest semver tag reachable from origin/<branch>; the tag
#            itself must carry a good signature (git verify-tag). Default.
#   branch   the tip of origin/<branch>; the commit must carry a good
#            signature (git verify-commit).
#
# Safety rails, all of which must pass before anything is pulled:
#   1. the checkout lives at the expected path (override needs an explicit opt-in)
#   2. `origin` points at the expected repository
#   3. the target carries a good signature from the expected signer
#   4. the user confirms the change interactively (skip with --yes)

set -euo pipefail

SECLOG_LIB="$(dirname "$(readlink -f "$0")")/seclog-lib.sh"
[[ -f $SECLOG_LIB ]] || SECLOG_LIB="$HOME/.local/bin/seclog-lib.sh"
# shellcheck source=seclog-lib.sh
. "$SECLOG_LIB"

usage() {
    cat <<'HELP'
Usage: seclog-update [--yes] [--channel release|branch]

Fetches the newest signed release (or signed branch tip) of the installed git
checkout, shows what would change, asks for confirmation, then fast-forwards,
re-runs install.sh and restarts seclog-monitor.

Options:
  -y, --yes            Do not ask. Requires UPDATE_SIGNER to be set.
  --channel CHANNEL    release (default) or branch; overrides UPDATE_CHANNEL.
  -h, --help           Show this help.
HELP
}

ASSUME_YES=0
CHANNEL_OVERRIDE=""
while (( $# )); do
    case "$1" in
        -y|--yes)   ASSUME_YES=1 ;;
        --channel)  CHANNEL_OVERRIDE="${2:-}"; shift ;;
        --channel=*) CHANNEL_OVERRIDE="${1#*=}" ;;
        -h|--help)  usage; exit 0 ;;
        *) printf 'seclog-update: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
    shift
done

seclog_load_config

DEFAULT_REPO_DIR="$HOME/Projects/seclog-linux"
REPO_DIR="${SECLOG_REPO_DIR:-$DEFAULT_REPO_DIR}"
SERVICE="seclog-monitor.service"
ALLOW_CUSTOM_REPO_DIR="${ALLOW_CUSTOM_REPO_DIR:-0}"
EXPECTED_ORIGINS=(
    "${EXPECTED_UPDATE_ORIGIN:-https://github.com/arn-c0de/seclog-linux.git}"
    "${EXPECTED_UPDATE_ORIGIN_ALT:-git@github.com:arn-c0de/seclog-linux.git}"
)
CHANNEL="${CHANNEL_OVERRIDE:-$UPDATE_CHANNEL}"

# Identity the target must be signed by. For SSH signing this is the principal
# from the allowed_signers file, for OpenPGP the uid on the key. Matched as a
# substring so either an e-mail or a full uid works.
UPDATE_SIGNER="${UPDATE_SIGNER:-}"

die() { printf 'seclog-update: %s\n' "$*" >&2; exit 1; }

case "$CHANNEL" in
    release|branch) ;;
    *) die "UPDATE_CHANNEL must be release or branch, got: $CHANNEL" ;;
esac

# ── 1. Locate and validate the checkout ──────────────────────────────────
[[ -d $REPO_DIR/.git ]] || die "no git checkout at $REPO_DIR — set SECLOG_REPO_DIR and retry"

repo="$(cd -- "$REPO_DIR" && pwd -P)"
expected_repo="$DEFAULT_REPO_DIR"
[[ -d $DEFAULT_REPO_DIR ]] && expected_repo="$(cd -- "$DEFAULT_REPO_DIR" && pwd -P)"

if [[ -n ${SECLOG_REPO_DIR:-} && $repo != "$expected_repo" && $ALLOW_CUSTOM_REPO_DIR != 1 ]]; then
    die "refusing a custom SECLOG_REPO_DIR without ALLOW_CUSTOM_REPO_DIR=1"$'\n'"  expected: $expected_repo"$'\n'"  got:      $repo"
fi

cd -- "$repo"

# GitHub hands out both forms; a trailing ".git" or "/" is not a different repo.
normalize_origin() { local o="${1%/}"; printf '%s' "${o%.git}"; }
origin="$(git remote get-url origin)"
matched=0
for candidate in "${EXPECTED_ORIGINS[@]}"; do
    [[ "$(normalize_origin "$origin")" == "$(normalize_origin "$candidate")" ]] && matched=1
done
(( matched )) || die "refusing to update from an unexpected origin: $origin"$'\n'"  expected one of: ${EXPECTED_ORIGINS[*]}"

branch="$(git branch --show-current)"
[[ -n $branch ]] || die "no branch checked out in $repo (detached HEAD)"

installer="$repo/install.sh"
[[ -f $installer ]] || die "installer not found at $installer"

# ── 2. Compare local and remote ──────────────────────────────────────────
echo "== seclog-update =="
printf 'Repo:    %s\nBranch:  %s\nRemote:  %s\nChannel: %s\n' "$repo" "$branch" "$origin" "$CHANNEL"

git fetch origin --prune --tags

local_commit="$(git rev-parse HEAD)"
local_short="$(git rev-parse --short "$local_commit")"
printf 'Current: %s (%s)\n' "$local_short" "$(git log -1 --pretty=%s "$local_commit")"

target_tag=""
if [[ $CHANNEL == release ]]; then
    # Newest semver tag whose commit is part of the branch we follow.
    target_tag="$(git tag --list --merged "origin/$branch" --sort=-v:refname |
        grep -E '^v?[0-9]+\.[0-9]+\.[0-9]+$' | head -1 || true)"
    [[ -n $target_tag ]] || die "no release tag (vX.Y.Z) is reachable from origin/$branch"$'\n'"  either the maintainer has not tagged a release on this branch yet, or set UPDATE_CHANNEL=branch to follow signed commits"
    remote_commit="$(git rev-parse "$target_tag^{commit}")"
    target_label="$target_tag"
else
    remote_commit="$(git rev-parse "origin/$branch")"
    target_label="origin/$branch"
fi
remote_short="$(git rev-parse --short "$remote_commit")"

if [[ $local_commit == "$remote_commit" ]]; then
    printf 'Update:  already up to date (%s)\n' "$target_label"
    exit 0
fi
if git merge-base --is-ancestor "$remote_commit" "$local_commit"; then
    printf 'Update:  checkout is ahead of %s (%s); nothing to do\n' "$target_label" "$remote_short"
    exit 0
fi

printf 'Target:  %s (%s)%s\n' "$remote_short" "$(git log -1 --pretty=%s "$remote_commit")" "${target_tag:+ [tag $target_tag]}"

# ── 3. Require a good signature from the expected signer ─────────────────
# The signature format depends on git's gpg.format, and the two backends print
# different things:
#   ssh      Good "git" signature for <principal> with ED25519 key SHA256:...
#   openpgp  gpg: Good signature from "Name <mail>" [ultimate]
# Accept either, but never accept "exit status 0" on its own — for OpenPGP that
# only means the key sits in the local keyring, which is not a trust decision.
verify_output=""
verify_status=0
if [[ -n $target_tag ]]; then
    verify_output="$(git verify-tag --raw "$target_tag" 2>&1)" || verify_status=$?
    verified_what="tag $target_tag"
else
    verify_output="$(git verify-commit --raw "$remote_commit" 2>&1)" || verify_status=$?
    verified_what="commit $remote_short"
fi

signer="$(awk '
    /^Good "git" signature for / { sub(/^Good "git" signature for /, ""); sub(/ with .*/, ""); print; exit }
    /^gpg: Good signature from "/ { sub(/^gpg: Good signature from "/, ""); sub(/".*/, ""); print; exit }
    /^\[GNUPG:\] GOODSIG /       { sub(/^\[GNUPG:\] GOODSIG [0-9A-Fa-f]+ /, ""); print; exit }
' <<<"$verify_output")"

if (( verify_status != 0 )) || [[ -z $signer ]]; then
    printf 'VERIFIED: no — %s is not signed by a trusted key, aborting\n' "$verified_what" >&2
    printf '%s\n' "$verify_output" >&2
    if [[ -n $target_tag ]] && ! git cat-file -e "$target_tag^{tag}" 2>/dev/null; then
        printf 'Note: %s is a lightweight tag; releases must be annotated, signed tags (git tag -s).\n' "$target_tag" >&2
    fi
    if [[ $verify_output == *allowedSignersFile* || $verify_output == *"allowed keys file"* \
       || $verify_output == *"No principal matched"* ]]; then
        cat >&2 <<'HINT'

Signature verification is not set up on this host. For SSH-signed commits:
  printf '%s %s\n' <signer-id> "$(cat /path/to/signing_key.pub)" > ~/.config/seclog-linux/allowed_signers
  git config gpg.format ssh
  git config gpg.ssh.allowedSignersFile ~/.config/seclog-linux/allowed_signers
HINT
    fi
    exit 1
fi

if [[ -n $UPDATE_SIGNER ]]; then
    if [[ $signer != *"$UPDATE_SIGNER"* ]]; then
        printf 'VERIFIED: no — signed by an unexpected identity, aborting\n' >&2
        printf '  expected: %s\n  got:      %s\n' "$UPDATE_SIGNER" "$signer" >&2
        exit 1
    fi
    printf 'VERIFIED: yes (%s, matches UPDATE_SIGNER)\n' "$signer"
else
    printf 'VERIFIED: yes (%s)\n' "$signer"
    printf 'WARNING:  UPDATE_SIGNER is not set in %s, so any identity your git\n' "$SECLOG_CONFIG" >&2
    printf '          trust store accepts can ship you code. Pin it.\n' >&2
    # Unattended runs must pin the signer: there is nobody to read the warning.
    (( ASSUME_YES )) && die "--yes requires UPDATE_SIGNER to be set in $SECLOG_CONFIG"
fi

# ── 4. Confirm, then apply ───────────────────────────────────────────────
if (( ! ASSUME_YES )); then
    read -r -p "Proceed with update? [y/N] " confirm
    [[ $confirm == [yY] ]] || { echo "Aborted."; exit 0; }
fi

printf 'Updating: %s -> %s\n' "$local_short" "$remote_short"
# Fast-forward to the exact commit that was verified, never to whatever the
# ref points at by now.
git merge --ff-only "$remote_commit"

bash "$installer"

systemctl --user daemon-reload
systemctl --user restart "$SERVICE"

# ── 5. Announce ──────────────────────────────────────────────────────────
new_short="$(git rev-parse --short HEAD)"
subject="$(git log -1 --pretty=%s HEAD)"
ip="$(hostname -I 2>/dev/null | awk '{ print $1 }')"
[[ -z $ip ]] && ip="$(ip route get 1 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit } }')"

body="$(printf 'Host:    %s\nIP:      %s\nBranch:  %s\nRelease: %s\nFrom:    %s\nTo:      %s\nCommit:  %s\nSigner:  %s\nTime:    %s' \
    "$HOSTNAME" "${ip:-unknown}" "$branch" "${target_tag:-(branch tip)}" "$local_short" "$new_short" \
    "$subject" "$signer" "$(seclog_now)")"

seclog_push "seclog updated on $HOSTNAME: ${target_tag:-$subject}" "arrows_counterclockwise,white_check_mark" "default" "$body" || true

printf 'Service: %s\n' "$(systemctl --user is-active "$SERVICE" || true)"
printf 'Commit:  %s (%s)\n' "$new_short" "$subject"
