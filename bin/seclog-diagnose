#!/usr/bin/env bash
# seclog-diagnose — check that dependencies, config, permissions and the
# background service are all healthy. Exits non-zero if anything failed.
#
#   --no-push   skip the ntfy connectivity check (no notification is sent)

set -uo pipefail

SECLOG_LIB="$(dirname "$(readlink -f "$0")")/seclog-lib.sh"
[[ -f $SECLOG_LIB ]] || SECLOG_LIB="$HOME/.local/bin/seclog-lib.sh"
# shellcheck source=seclog-lib.sh
. "$SECLOG_LIB"

send_push=1
for arg in "$@"; do
    case "$arg" in
        --no-push) send_push=0 ;;
        -h|--help)
            echo "Usage: seclog-diagnose [--no-push]"
            echo "Checks dependencies, config, permissions and the monitor service."
            exit 0 ;;
        *) printf 'seclog-diagnose: unknown option: %s\n' "$arg" >&2; exit 2 ;;
    esac
done

seclog_load_config

SERVICE="seclog-monitor.service"
pass=0 warn=0 fail=0

ok()      { printf '  [OK  ] %s\n' "$*"; (( ++pass )); }
warning() { printf '  [WARN] %s\n' "$*"; (( ++warn )); }
failure() { printf '  [FAIL] %s\n' "$*"; (( ++fail )); }

section() { printf '\n[ %s ]\n' "$1"; }

printf '── seclog-linux %s diagnostics ──\n' "$SECLOG_VERSION"

section "Prerequisites"
for cmd in curl awk sort ss who getent timeout journalctl systemctl logger git; do
    if command -v "$cmd" >/dev/null 2>&1; then
        ok "$cmd found"
    else
        failure "$cmd not found"
    fi
done
if (( BASH_VERSINFO[0] < 5 )); then
    failure "bash ${BASH_VERSION} is too old — seclog 1.0.3 and later need bash 5"
else
    ok "bash $BASH_VERSION"
fi
seclog_geo_backend
case "$SECLOG_GEO_BACKEND" in
    mmdb)   ok "geo-location via mmdblookup ($SECLOG_GEO_DB)" ;;
    legacy) warning "geo-location via legacy geoiplookup — its database is unmaintained; prefer libmaxminddb + GeoLite2 (set GEOIP_DB if the file is somewhere unusual)" ;;
    *)      warning "no geo backend — install mmdblookup (apt: mmdb-bin) with a GeoLite2 database, or geoip-bin + geoip-database" ;;
esac

section "Config"
if [[ -f $SECLOG_CONFIG ]]; then
    ok "config found: $SECLOG_CONFIG"
    perms="$(stat -Lc '%a' "$SECLOG_CONFIG" 2>/dev/null || echo '?')"
    if seclog_path_is_trusted "$SECLOG_CONFIG"; then
        ok "config permissions are $perms and it is owned by you"
    else
        # seclog_load_config would already have refused to run, so this only
        # shows up when the config changed underneath a running install.
        failure "config is mode $perms and writable by others or foreign-owned; run: chmod 600 $SECLOG_CONFIG"
    fi
else
    failure "config missing: $SECLOG_CONFIG — run install.sh first"
fi

if seclog_ntfy_configured; then
    ok "NTFY_URL set: $(seclog_mask_url "$NTFY_URL")"
    if [[ $NTFY_URL == https://* ]]; then
        ok "ntfy transport is TLS"
    elif seclog_transport_ok; then
        warning "ntfy transport is plaintext HTTP — accepted because the target is local or NTFY_ALLOW_PLAINTEXT=1"
    else
        failure "ntfy transport is plaintext HTTP to a non-local address — pushes are refused; use https:// or set NTFY_ALLOW_PLAINTEXT=1"
    fi
    if [[ -n $NTFY_TOKEN ]]; then
        ok "NTFY_TOKEN set"
    else
        warning "NTFY_TOKEN empty (fine for public topics)"
    fi
    if [[ $PUSH_METADATA_LEVEL == full ]]; then
        warning "PUSH_METADATA_LEVEL=full — pushes carry uid, groups, rDNS and the SSH key fingerprint"
    else
        ok "PUSH_METADATA_LEVEL=$PUSH_METADATA_LEVEL"
    fi
    case "$LOGIN_PUSH_SOURCE" in
        monitor|both) ok "login pushes come from the monitor, which sees every login" ;;
        banner)       warning "LOGIN_PUSH_SOURCE=banner — only interactive bash logins are announced; scp, sftp, rsync and non-interactive ssh commands are not" ;;
        *)            failure "LOGIN_PUSH_SOURCE=$LOGIN_PUSH_SOURCE is not one of monitor|banner|both" ;;
    esac
else
    failure "NTFY_URL not configured in $SECLOG_CONFIG"
fi
if [[ -n $BANNER_EXTRA_FILE ]]; then
    if [[ -r $BANNER_EXTRA_FILE ]]; then
        ok "BANNER_EXTRA_FILE readable: $BANNER_EXTRA_FILE"
    else
        warning "BANNER_EXTRA_FILE is set but not readable: $BANNER_EXTRA_FILE"
    fi
fi

section "Network"
if ! seclog_ntfy_configured; then
    warning "skipping ntfy connectivity check (NTFY_URL not configured)"
elif (( ! send_push )); then
    warning "skipping ntfy connectivity check (--no-push)"
elif seclog_push "seclog-diagnose" "wrench" "low" "Test push from $HOSTNAME at $(seclog_now)"; then
    ok "ntfy reachable and accepted a test push"
else
    failure "ntfy unreachable or auth rejected — check NTFY_URL and NTFY_TOKEN"
fi

section "Permissions"
if seclog_journal_restricted; then
    warning "this account cannot read the system journal — SSH log history stays empty and the monitor sees nothing"
    warning "  fix: sudo usermod -aG systemd-journal \$USER   (then re-login)"
else
    ok "system journal is readable"
fi

case ":$PATH:" in
    *":$HOME/.local/bin:"*) ok "\$HOME/.local/bin is in PATH" ;;
    *) warning "\$HOME/.local/bin is NOT in PATH — add to .profile: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
esac

section "Service"
if systemctl --user is-active --quiet "$SERVICE"; then
    ok "$SERVICE is active"
else
    failure "$SERVICE is NOT running — check: systemctl --user status $SERVICE"
fi

if systemctl --user is-enabled --quiet "$SERVICE" 2>/dev/null; then
    ok "$SERVICE is enabled"
else
    warning "$SERVICE is not enabled (it will not auto-start)"
fi

if loginctl show-user "$USER" -p Linger 2>/dev/null | grep -q 'Linger=yes'; then
    ok "lingering is enabled (monitor survives logout)"
else
    warning "lingering is off — the monitor stops on logout; run: sudo loginctl enable-linger $USER"
fi

if [[ -s $SECLOG_STATE_DIR/journal.cursor ]]; then
    ok "journal cursor saved — the monitor resumes where it stopped"
else
    warning "no journal cursor yet in $SECLOG_STATE_DIR (normal until the first event was seen)"
fi

section "Update trust"
# seclog-update fetches code and then runs its installer, so the signature
# checks are the last line of defence for the whole install.
repo="${SECLOG_REPO_DIR:-$HOME/Projects/seclog-linux}"
if [[ -d $repo/.git ]]; then
    ok "checkout found: $repo"

    sig_format="$(git -C "$repo" config --get gpg.format || echo openpgp)"
    ok "commit signature format: $sig_format"

    if [[ $sig_format == ssh ]]; then
        signers="$(git -C "$repo" config --get gpg.ssh.allowedSignersFile || true)"
        if [[ -z $signers ]]; then
            failure "gpg.ssh.allowedSignersFile is unset — every seclog-update will abort"
            printf '         git -C %s config gpg.ssh.allowedSignersFile ~/.config/seclog-linux/allowed_signers\n' "$repo"
        elif [[ ! -f ${signers/#\~/$HOME} ]]; then
            failure "gpg.ssh.allowedSignersFile points at a missing file: $signers"
        else
            ok "allowed signers file present: $signers"
        fi
    fi

    case "$UPDATE_CHANNEL" in
        release)
            latest="$(git -C "$repo" tag --list --sort=-v:refname 'v[0-9]*' '[0-9]*' 2>/dev/null |
                grep -E '^v?[0-9]+\.[0-9]+\.[0-9]+$' | head -1)"
            if [[ -n $latest ]]; then
                ok "UPDATE_CHANNEL=release — newest known release tag: $latest"
            else
                warning "UPDATE_CHANNEL=release but no release tag is known yet — run seclog-update to fetch tags, or set UPDATE_CHANNEL=branch"
            fi ;;
        branch) warning "UPDATE_CHANNEL=branch — updates follow the signed tip of the branch rather than tagged releases" ;;
        *)      failure "UPDATE_CHANNEL=$UPDATE_CHANNEL is not one of release|branch" ;;
    esac

    if [[ -n ${UPDATE_SIGNER:-} ]]; then
        ok "UPDATE_SIGNER pinned: $UPDATE_SIGNER"
    else
        warning "UPDATE_SIGNER is not set — any identity your git trust store accepts can ship you code"
        warning "  fix: add UPDATE_SIGNER=\"<the maintainer's signing identity>\" to $SECLOG_CONFIG"
    fi
else
    warning "no checkout at $repo — seclog-update is unavailable (that is fine if you installed from a tarball)"
fi

printf '\n── Result: %d ok, %d warnings, %d failures ──\n' "$pass" "$warn" "$fail"
(( fail == 0 ))
