#!/usr/bin/env bash
# seclog-diagnose — check that dependencies, config, permissions and the
# background service are all healthy. Exits non-zero if anything failed.

set -uo pipefail

SECLOG_LIB="$(dirname "$(readlink -f "$0")")/seclog-lib.sh"
[[ -f $SECLOG_LIB ]] || SECLOG_LIB="$HOME/.local/bin/seclog-lib.sh"
# shellcheck source=seclog-lib.sh
. "$SECLOG_LIB"

seclog_load_config

SERVICE="seclog-monitor.service"
pass=0 warn=0 fail=0

ok()      { printf '  [OK  ] %s\n' "$*"; (( ++pass )); }
warning() { printf '  [WARN] %s\n' "$*"; (( ++warn )); }
failure() { printf '  [FAIL] %s\n' "$*"; (( ++fail )); }

section() { printf '\n[ %s ]\n' "$1"; }

printf '── seclog-linux %s diagnostics ──\n' "$SECLOG_VERSION"

section "Prerequisites"
for cmd in curl awk sort ss who getent timeout journalctl systemctl; do
    if command -v "$cmd" >/dev/null 2>&1; then
        ok "$cmd found"
    else
        failure "$cmd not found"
    fi
done
if command -v geoiplookup >/dev/null 2>&1; then
    ok "geoiplookup found (geo-location active)"
else
    warning "geoiplookup not found — install: sudo apt install geoip-bin geoip-database"
fi

section "Config"
if [[ -f $SECLOG_CONFIG ]]; then
    ok "config found: $SECLOG_CONFIG"
    perms="$(stat -c '%a' "$SECLOG_CONFIG" 2>/dev/null || echo '?')"
    if [[ $perms == 600 || $perms == 400 ]]; then
        ok "config permissions are $perms"
    else
        warning "config is mode $perms — it may hold a token; run: chmod 600 $SECLOG_CONFIG"
    fi
else
    failure "config missing: $SECLOG_CONFIG — run install.sh first"
fi

if seclog_ntfy_configured; then
    ok "NTFY_URL set: $NTFY_URL"
    if [[ -n $NTFY_TOKEN ]]; then
        ok "NTFY_TOKEN set"
    else
        warning "NTFY_TOKEN empty (fine for public topics)"
    fi
else
    failure "NTFY_URL not configured in $SECLOG_CONFIG"
fi

section "Network"
if seclog_ntfy_configured; then
    if seclog_push "seclog-diagnose" "wrench" "low" "Test push from $(hostname) at $(date '+%F %T %Z')"; then
        ok "ntfy reachable and accepted a test push"
    else
        failure "ntfy unreachable or auth rejected — check NTFY_URL and NTFY_TOKEN"
    fi
else
    warning "skipping ntfy connectivity check (NTFY_URL not configured)"
fi

section "Permissions"
if seclog_journal_restricted; then
    warning "user is not in the systemd-journal group — SSH log history may be empty"
    warning "  fix: sudo usermod -aG systemd-journal \$USER   (then re-login)"
else
    ok "sshd journal is readable"
fi

case ":$PATH:" in
    *":$HOME/.local/bin:"*) ok "\$HOME/.local/bin is in PATH" ;;
    *) warning "\$HOME/.local/bin is NOT in PATH — add to .profile: export PATH=\"\$HOME/.local/bin:\$PATH\"" ;;
esac

section "Service"
if systemctl --user is-active --quiet "$SERVICE"; then
    ok "$SERVICE is active"
else
    failure "$SERVICE is NOT running — check: systemctl --user status $SERVICE"
fi

if systemctl --user is-enabled --quiet "$SERVICE" 2>/dev/null; then
    ok "$SERVICE is enabled"
else
    warning "$SERVICE is not enabled (it will not auto-start)"
fi

if loginctl show-user "$USER" -p Linger 2>/dev/null | grep -q 'Linger=yes'; then
    ok "lingering is enabled (monitor survives logout)"
else
    warning "lingering is off — the monitor stops on logout; run: sudo loginctl enable-linger $USER"
fi

printf '\n── Result: %d ok, %d warnings, %d failures ──\n' "$pass" "$warn" "$fail"
(( fail == 0 ))
