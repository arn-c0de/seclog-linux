#!/usr/bin/env bash
# seclog-monitor — follow the journal for failed SSH logins and push them to ntfy.
#
# Rate limit: at most one push per source IP per FAIL_RATELIMIT_WINDOW seconds,
# so a brute-force run produces a handful of notifications instead of thousands.
# Suppressed attempts are counted and reported in the next push for that IP.

set -uo pipefail

SECLOG_LIB="$(dirname "$(readlink -f "$0")")/seclog-lib.sh"
[[ -f $SECLOG_LIB ]] || SECLOG_LIB="$HOME/.local/bin/seclog-lib.sh"
# shellcheck source=seclog-lib.sh
. "$SECLOG_LIB"

seclog_load_config

if ! seclog_ntfy_configured; then
    printf 'seclog-monitor: NTFY_URL is not configured in %s\n' "$SECLOG_CONFIG" >&2
    exit 1
fi

STATE_DIR="${STATE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/seclog-linux}"
STATE_TTL_DAYS="${STATE_TTL_DAYS:-7}"
mkdir -p "$STATE_DIR"

# Drop state for IPs we have not heard from in a while, so the directory does
# not grow without bound on an internet-facing host.
find "$STATE_DIR" -maxdepth 1 -type f -mtime "+$STATE_TTL_DAYS" -delete 2>/dev/null || true

if seclog_journal_restricted; then
    printf 'seclog-monitor: %s cannot read sshd journal entries; add it to the systemd-journal group and re-login\n' \
        "$USER" >&2
fi

# Turn one journal line into "<user>\t<ip>\t<port>\t<reason>", or nothing when
# the line carries no source address.
parse_event() {
    awk '
        # First token after a bare word, e.g. after("from") in "... from 1.2.3.4 ...".
        function after(name,   i) {
            for (i = 1; i < NF; i++) if ($i == name) return $(i + 1)
            return ""
        }
        # Value of a "key=value" token, as used by the pam_unix log format.
        function kv(key,   m) {
            if (!match($0, "(^|[ \t])" key "=[^ \t]+")) return ""
            m = substr($0, RSTART, RLENGTH)
            sub(/^[ \t]/, "", m)
            sub(/^[^=]*=/, "", m)
            return m
        }

        BEGIN { OFS = "\t" }
        {
            user = after("for")
            if (user == "" || user == "invalid") user = after("user")
            if (user == "") user = kv("user")
            if (user == "") user = "?"

            ip = after("from")
            # "Disconnected from authenticating user <user> <ip> port <port>"
            # puts the address after the user name instead of after "from".
            if (ip == "authenticating") ip = after(user)
            if (ip == "") ip = kv("rhost")
            if (ip !~ /^[0-9]+\.[0-9.]+$|:/) next

            port = after("port")
            if (port !~ /^[0-9]+$/) port = "?"

            reason = "authentication failure"
            if (index($0, "Failed password"))    reason = "failed password"
            else if (index($0, "Invalid user"))  reason = "invalid user"
            else if (index($0, "Disconnected"))  reason = "disconnected while authenticating"

            print user, ip, port, reason
        }'
}

journalctl -f -n 0 --no-pager "${SECLOG_SSHD_MATCH[@]}" 2>/dev/null |
while IFS= read -r line; do
    case "$line" in
        *"Failed password for "*|*"Invalid user "*|*"authentication failure"*|*"Disconnected from authenticating user"*) ;;
        *) continue ;;
    esac

    IFS=$'\t' read -r user ip port reason < <(parse_event <<<"$line")
    [[ -n ${ip:-} ]] || continue

    # State file per IP: "<epoch of last push> <attempts suppressed since>".
    state="$STATE_DIR/${ip//[^0-9A-Za-z.:_-]/_}"
    last_push=0; suppressed=0
    [[ -f $state ]] && read -r last_push suppressed <"$state"
    now="$(date +%s)"

    if (( now - last_push < FAIL_RATELIMIT_WINDOW )); then
        printf '%s %s\n' "$last_push" "$(( suppressed + 1 ))" >"$state"
        continue
    fi
    printf '%s 0\n' "$now" >"$state"

    body="$(printf 'Reason: %s\nIP:     %s:%s\nUser:   %s\nSuppressed since last push: %s\nTime:   %s' \
        "$reason" "$ip" "$port" "$user" "$suppressed" "$(date '+%Y-%m-%d %H:%M:%S %Z')")"

    seclog_push "SSH FAILED: $user from $ip" "skull,warning" "high" "$body" || true
done
