#!/usr/bin/env bash
# seclog-monitor — follow the journal for SSH authentication events and push
# them to ntfy.
#
# This is the only component that sees *every* login. The .bashrc banner runs
# for interactive bash sessions and nothing else, so `ssh host cmd`, scp, sftp,
# rsync, git-over-ssh and any other login shell would otherwise arrive without
# a notification. Successful logins are therefore reported from here by
# default (LOGIN_PUSH_SOURCE).
#
# Pipeline:  journalctl -f -o json | awk (parse, one process) | bash (rate
# limit, push). The journal cursor of the last handled event is saved after
# every event, so a restart — reboot, update, crash — resumes exactly where the
# previous instance stopped instead of silently skipping whatever happened in
# between.
#
# Rate limit: at most one failure push per source IP per FAIL_RATELIMIT_WINDOW
# seconds, so a brute-force run produces a handful of notifications instead of
# thousands. Suppressed attempts are counted and reported in the next push.

set -uo pipefail

SECLOG_LIB="$(dirname "$(readlink -f "$0")")/seclog-lib.sh"
[[ -f $SECLOG_LIB ]] || SECLOG_LIB="$HOME/.local/bin/seclog-lib.sh"
# shellcheck source=seclog-lib.sh
. "$SECLOG_LIB"

seclog_load_config

# EX_CONFIG. The unit maps this to "do not restart": without it systemd would
# spin on a fresh install, where the config still holds the placeholder URL.
readonly EX_CONFIG=78

if ! seclog_ntfy_configured; then
    seclog_log err "not starting: NTFY_URL is not configured in $SECLOG_CONFIG"
    exit "$EX_CONFIG"
fi
if ! seclog_transport_ok; then
    seclog_log err "not starting: $(seclog_mask_url "$NTFY_URL") is plaintext HTTP to a non-local address; use https:// or set NTFY_ALLOW_PLAINTEXT=1"
    exit "$EX_CONFIG"
fi

STATE_DIR="$SECLOG_STATE_DIR"
if ! mkdir -p "$STATE_DIR"; then
    seclog_log err "cannot create state directory $STATE_DIR — rate limiting would be disabled"
    exit "$EX_CONFIG"
fi
CURSOR_FILE="$STATE_DIR/journal.cursor"

# Drop state for IPs we have not heard from in a while, so the directory does
# not grow without bound on an internet-facing host.
find "$STATE_DIR" -maxdepth 1 -type f \( -name 'fail-*' -o -name 'login-*' \) \
    -mtime "+$STATE_TTL_DAYS" -delete 2>/dev/null || true

if seclog_journal_restricted; then
    seclog_log warning "$USER cannot read the system journal; add the account to the systemd-journal group and re-login"
fi

# ── Resume point ─────────────────────────────────────────────────────────
# A saved cursor that journald no longer knows (vacuumed, or from another
# machine's journal) makes journalctl fail immediately, so validate it first.
start_args=(-n 0)
if [[ -s $CURSOR_FILE ]]; then
    IFS= read -r saved_cursor <"$CURSOR_FILE" || saved_cursor=""
    if [[ -n $saved_cursor ]] &&
        journalctl -q -n 0 --after-cursor="$saved_cursor" "${SECLOG_SSHD_MATCH[@]}" >/dev/null 2>&1; then
        start_args=(--after-cursor="$saved_cursor")
        seclog_log notice "resuming from the saved journal cursor"
    else
        seclog_log warning "saved journal cursor is unusable, starting from now"
        rm -f "$CURSOR_FILE"
    fi
fi

seclog_log notice "monitor started (login pushes: $LOGIN_PUSH_SOURCE, window: ${FAIL_RATELIMIT_WINDOW}s, replay max age: ${REPLAY_MAX_AGE}s)"

# Read "<epoch> <count>" from a state file, rejecting anything that is not a
# plain number. The values feed an arithmetic context, where bash would happily
# evaluate `a[$(command)]`.
read_state() {
    local file="$1" stamp count
    state_stamp=0; state_count=0
    [[ -f $file ]] || return 0
    read -r stamp count <"$file" || return 0
    [[ ${stamp:-} =~ ^[0-9]+$ ]] && state_stamp="$stamp"
    [[ ${count:-} =~ ^[0-9]+$ ]] && state_count="$count"
    return 0
}

save_cursor() {
    [[ -n $1 ]] || return 0
    printf '%s\n' "$1" >"$CURSOR_FILE.tmp" && mv -f "$CURSOR_FILE.tmp" "$CURSOR_FILE"
}

stale=0

journalctl -f --no-pager -o json "${start_args[@]}" "${SECLOG_SSHD_MATCH[@]}" 2>/dev/null |
    seclog_parse_events |
while IFS=$'\t' read -r kind user ip port reason epoch cursor; do
    [[ -n ${ip:-} ]] || continue
    save_cursor "$cursor"

    now="$EPOCHSECONDS"
    # The IP is already validated by the parser; the substitution is belt and
    # braces so a state file can never escape the directory.
    safe_ip="${ip//[^0-9A-Za-z.:_-]/_}"

    # Catching up after downtime: old events are recorded, not announced. A
    # push about a login from last week is noise, and a brute-force backlog
    # would arrive as one burst.
    if (( epoch > 0 && now - epoch > REPLAY_MAX_AGE )); then
        (( ++stale ))
        if [[ $kind == fail ]]; then
            state="$STATE_DIR/fail-$safe_ip"
            read_state "$state"
            printf '%s %s\n' "$state_stamp" "$(( state_count + 1 ))" >"$state"
        fi
        continue
    fi
    if (( stale > 0 )); then
        seclog_log notice "skipped $stale event(s) older than ${REPLAY_MAX_AGE}s while catching up"
        stale=0
    fi

    when="$(seclog_fmt_time "$epoch")"

    if [[ $kind == ok ]]; then
        [[ $LOGIN_PUSH_SOURCE == monitor || $LOGIN_PUSH_SOURCE == both ]] || continue

        # Collapse bursts from the same account and address — one rsync run or
        # a scp loop opens many short sessions.
        state="$STATE_DIR/login-${safe_ip}-${user}"
        read_state "$state"
        (( now - state_stamp < LOGIN_DEDUP_WINDOW )) && continue
        printf '%s 0\n' "$now" >"$state"

        body="$(printf 'User:   %s\nFrom:   %s\nAuth:   %s\nOrigin: %s\nHost:   %s\nTime:   %s' \
            "$user" \
            "$(seclog_format_endpoint "$ip" "$port")" \
            "$reason" \
            "$(seclog_geo_or_unknown "$ip")" \
            "$HOSTNAME" \
            "$when")"

        seclog_push "SSH login: $user from $ip" "warning,key" "high" "$body" || true
        continue
    fi

    # State file per IP: "<epoch of last push> <attempts suppressed since>".
    state="$STATE_DIR/fail-$safe_ip"
    read_state "$state"

    if (( now - state_stamp < FAIL_RATELIMIT_WINDOW )); then
        printf '%s %s\n' "$state_stamp" "$(( state_count + 1 ))" >"$state"
        continue
    fi
    printf '%s 0\n' "$now" >"$state"

    body="$(printf 'Reason: %s\nIP:     %s\nOrigin: %s\nUser:   %s\nSuppressed since last push: %s\nTime:   %s' \
        "$reason" \
        "$(seclog_format_endpoint "$ip" "$port")" \
        "$(seclog_geo_or_unknown "$ip")" \
        "$user" \
        "$state_count" \
        "$when")"

    seclog_push "SSH FAILED: $user from $ip" "skull,warning" "high" "$body" || true
done

# The pipeline only ends when journalctl goes away; that is a failure worth a
# restart, never a clean exit.
seclog_log err "journal stream ended, exiting so systemd restarts the monitor"
exit 1
